<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="News Card Grid"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Tab 1: Section Header & Cards -->
                    <cardsTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Cards Configuration"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Section Title"
                                                fieldDescription="Header displayed above the cards"
                                                name="./title"
                                                emptyText="See What's Happening In Our Universe"/>
                                            <cards
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Cards"
                                                fieldDescription="Add article/news cards with image, headline, excerpt, and redirection page link">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./cards">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <image
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldLabel="Card Image"
                                                            fieldDescription="Select image from DAM"
                                                            name="./image"
                                                            rootPath="/content/dam"/>
                                                        <imageAlt
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Image Alt Text"
                                                            fieldDescription="Alternative text for accessibility"
                                                            name="./imageAlt"/>
                                                        <cardTitle
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Card Headline / Title"
                                                            fieldDescription="Main headline of the card"
                                                            name="./cardTitle"
                                                            required="{Boolean}true"
                                                            emptyText="Enter card title"/>
                                                        <description
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldLabel="Card Description / Excerpt"
                                                            fieldDescription="Summary text or excerpt"
                                                            name="./description"
                                                            emptyText="Enter brief description..."/>
                                                        <pagePath
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldLabel="Target Page Redirection Path"
                                                            fieldDescription="Select the AEM content page to redirect when Read More is clicked"
                                                            name="./pagePath"
                                                            required="{Boolean}true"
                                                            rootPath="/content"/>
                                                        <linkText
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Read More Label"
                                                            fieldDescription="Text for the link (default: Read More...)"
                                                            name="./linkText"
                                                            emptyText="Read More..."/>
                                                        <openInNewTab
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            text="Open in new tab"
                                                            name="./openInNewTab"
                                                            value="true"
                                                            uncheckedValue="false"/>
                                                    </items>
                                                </field>
                                            </cards>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </cardsTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>

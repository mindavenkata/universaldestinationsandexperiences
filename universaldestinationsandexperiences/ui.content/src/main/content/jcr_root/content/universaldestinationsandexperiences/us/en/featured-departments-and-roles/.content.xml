<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Featured Departments and Roles"
        pageTitle="Featured Departments and Roles - Universal Destinations &amp; Experiences"
        cq:template="/conf/universaldestinationsandexperiences/settings/wcm/templates/page-content"
        sling:resourceType="universaldestinationsandexperiences/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="universaldestinationsandexperiences/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="universaldestinationsandexperiences/components/container"
                layout="responsiveGrid">
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="universaldestinationsandexperiences/components/container"
                    layout="responsiveGrid">

                    <!-- Variation 1: Image Left, White Theme -->
                    <spotlight_technical
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="universaldestinationsandexperiences/components/department-spotlight"
                        layout="image-left"
                        theme="theme-white"
                        ctaStyle="link"
                        title="Technical Services"
                        description="Use your technical and mechanical skills to keep our resort in perfect working order. That means making sure that our Universe is show ready and safe for our guests!"
                        image="/content/dam/universaldestinationsandexperiences/careers/technical-services.jpg"
                        imageAlt="Technician in blue hard hat"
                        primaryCtaLabel="Explore Open Roles"
                        primaryCtaLink="/content/universaldestinationsandexperiences/us/en/careers/technical-services"
                        primaryCtaOpenInNewTab="{Boolean}false"/>

                    <!-- Variation 2: Image Right, Soft Blue Theme -->
                    <spotlight_culinary
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="universaldestinationsandexperiences/components/department-spotlight"
                        layout="image-right"
                        theme="theme-soft-blue"
                        ctaStyle="link"
                        title="Culinary"
                        description="Join our Culinary family and learn from our very own masters of cuisine!"
                        image="/content/dam/universaldestinationsandexperiences/careers/culinary-chef.jpg"
                        imageAlt="Chef preparing pizza"
                        primaryCtaLabel="Explore Open Roles"
                        primaryCtaLink="/content/universaldestinationsandexperiences/us/en/careers/culinary"
                        primaryCtaOpenInNewTab="{Boolean}false"/>

                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
